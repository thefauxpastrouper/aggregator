generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notice {
  id         Int      @id @default(autoincrement())
  university String   // "DU", "JNU", "BHU"
  title      String
  summary    String?
  url        String   @unique
  date       DateTime @default(now())
  isPdf      Boolean  @default(false)
  createdAt  DateTime @default(now())
}
